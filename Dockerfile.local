FROM node:26-slim AS base
LABEL org.opencontainers.image.source="https://github.com/docmost/docmost"

RUN --mount=type=cache,id=docmost-npm-bootstrap,target=/root/.npm,sharing=locked \
  npm install -g pnpm@11.25.0 --fetch-retries=3 --fetch-timeout=60000

FROM base AS dependencies
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/server/package.json ./apps/server/package.json
COPY apps/client/package.json ./apps/client/package.json
COPY packages/editor-ext/package.json ./packages/editor-ext/package.json
COPY packages/base-formula/package.json ./packages/base-formula/package.json
COPY patches ./patches

RUN --mount=type=cache,id=docmost-build-pnpm,target=/pnpm/store,sharing=locked \
  pnpm install --frozen-lockfile --store-dir /pnpm/store --network-concurrency=8

FROM dependencies AS builder
COPY . .

ARG OEM=false
ARG OEM_HIDE_API_KEYS=false
ARG OEM_HIDE_SECURITY_SSO=false
ARG OEM_HIDE_API_MANAGEMENT=false
ARG OEM_HIDE_AUDIT_LOG=false
ARG OEM_HIDE_AI_SETTINGS=false
ARG OEM_HIDE_VERSION_UPDATE=false
ARG OEM_HIDE_LICENSE=false
ARG OEM_APP_NAME=Docmost
ARG OEM_HIDE_VERIFIED_PAGES=false

ENV OEM=$OEM
ENV OEM_HIDE_API_KEYS=$OEM_HIDE_API_KEYS
ENV OEM_HIDE_SECURITY_SSO=$OEM_HIDE_SECURITY_SSO
ENV OEM_HIDE_API_MANAGEMENT=$OEM_HIDE_API_MANAGEMENT
ENV OEM_HIDE_AUDIT_LOG=$OEM_HIDE_AUDIT_LOG
ENV OEM_HIDE_AI_SETTINGS=$OEM_HIDE_AI_SETTINGS
ENV OEM_HIDE_VERSION_UPDATE=$OEM_HIDE_VERSION_UPDATE
ENV OEM_HIDE_LICENSE=$OEM_HIDE_LICENSE
ENV OEM_APP_NAME=$OEM_APP_NAME
ENV OEM_HIDE_VERIFIED_PAGES=$OEM_HIDE_VERIFIED_PAGES

RUN pnpm build

FROM base AS installer

RUN apt-get update \
  && apt-get install -y --no-install-recommends curl bash \
  && rm -rf /var/lib/apt/lists/*

# drop npm and corepack
RUN rm -rf /usr/local/lib/node_modules/npm \
  && rm -rf /usr/local/lib/node_modules/corepack \
  && rm -rf /usr/local/bin/npm \
  && rm -rf /usr/local/bin/npx \
  && rm -rf /usr/local/bin/corepack \
  && rm -rf /root/.npm \
  && rm -rf /root/.node-gyp

WORKDIR /app

ARG OEM=false
ARG OEM_HIDE_API_KEYS=false
ARG OEM_HIDE_SECURITY_SSO=false
ARG OEM_HIDE_API_MANAGEMENT=false
ARG OEM_HIDE_AUDIT_LOG=false
ARG OEM_HIDE_AI_SETTINGS=false
ARG OEM_HIDE_VERSION_UPDATE=false
ARG OEM_HIDE_LICENSE=false
ARG OEM_APP_NAME=Docmost
ARG OEM_HIDE_VERIFIED_PAGES=false

ENV OEM=$OEM
ENV OEM_HIDE_API_KEYS=$OEM_HIDE_API_KEYS
ENV OEM_HIDE_SECURITY_SSO=$OEM_HIDE_SECURITY_SSO
ENV OEM_HIDE_API_MANAGEMENT=$OEM_HIDE_API_MANAGEMENT
ENV OEM_HIDE_AUDIT_LOG=$OEM_HIDE_AUDIT_LOG
ENV OEM_HIDE_AI_SETTINGS=$OEM_HIDE_AI_SETTINGS
ENV OEM_HIDE_VERSION_UPDATE=$OEM_HIDE_VERSION_UPDATE
ENV OEM_HIDE_LICENSE=$OEM_HIDE_LICENSE
ENV OEM_APP_NAME=$OEM_APP_NAME
ENV OEM_HIDE_VERIFIED_PAGES=$OEM_HIDE_VERIFIED_PAGES

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/server/package.json ./apps/server/package.json
COPY apps/client/package.json ./apps/client/package.json
COPY packages/editor-ext/package.json ./packages/editor-ext/package.json
COPY packages/base-formula/package.json ./packages/base-formula/package.json
COPY patches ./patches

RUN chown -R node:node /app
USER node
RUN --mount=type=cache,id=docmost-runtime-pnpm,target=/pnpm/store,uid=1000,gid=1000,sharing=locked \
  pnpm install --frozen-lockfile --prod --filter server... --store-dir /pnpm/store --network-concurrency=8 \
  && rm -rf /home/node/.cache/pnpm

COPY --from=builder --chown=node:node /app/apps/server/dist /app/apps/server/dist
COPY --from=builder --chown=node:node /app/apps/client/dist /app/apps/client/dist
COPY --from=builder --chown=node:node /app/packages/editor-ext/dist /app/packages/editor-ext/dist
COPY --from=builder --chown=node:node /app/packages/base-formula/dist /app/packages/base-formula/dist

RUN mkdir -p /app/data/storage
VOLUME ["/app/data/storage"]
EXPOSE 3000
CMD ["pnpm", "start"]
